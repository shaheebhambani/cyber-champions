# Environment variables for SecureWealth Twin API
# Copy this file to .env and fill in your actual API keys

# Firebase (already used)
FIREBASE_PROJECT_ID=your-firebase-project-id-here

# Currency Exchange API (exchangerate-api.com)
# Get free API key at: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key-here

# Email Verification API (Mailboxlayer)
# Get free API key at: https://mailboxlayer.com/
MAILBOXLAYER_API_KEY=your-mailboxlayer-api-key-here

# Phone Verification API (Numverify)
# Get free API key at: https://numverify.com/
NUMVERIFY_API_KEY=your-numverify-api-key-here

# Optional: Adjust cache duration for exchange rates (in seconds)
# EXCHANGE_RATE_CACHE_DURATION=3600